# ---------------------------------------------------------------------------
# GrowthRadar (webui) environment variables
# ---------------------------------------------------------------------------
# Copy to .env.local and fill in real values. .env.local is gitignored.
# webui dual-pushes to a PUBLIC repo (xuxiaoxin/growthlanding.ai) — NEVER commit
# real secrets. Keep them in .env.local (local) and Vercel project env (prod).
# ---------------------------------------------------------------------------

# Database (Neon Postgres)
#   DATABASE_URL        — pooled (PgBouncer), used by the runtime app
#   DATABASE_URL_UNPOOLED — direct session, used by drizzle-kit for DDL (push)
DATABASE_URL=postgresql://user:pass@host-pooler.neon.tech/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host.neon.tech/db?sslmode=require

# Resend — restricted API key, used only to send the newsletter digest
RESEND_API_KEY=re_xxxxxxxxxxxx

# Auth.js (next-auth v5)
#   Generate AUTH_SECRET with:  openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App — https://github.com/settings/developers
#   Authorization callback URL: https://growthlanding.ai/api/auth/callback/github
#   (local dev: http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: https://growthlanding.ai/api/auth/callback/google
#   (local dev: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
